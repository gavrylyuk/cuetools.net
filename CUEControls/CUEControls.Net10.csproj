<Project>
  <PropertyGroup>
    <BaseIntermediateOutputPath>obj\Net10\</BaseIntermediateOutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>CUEControls</AssemblyName>
    <RootNamespace>CUEControls</RootNamespace>
    <Version>2.2.6.0</Version>
    <EnableDefaultItems>false</EnableDefaultItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputPath>..\bin\$(Configuration)\net10.0-windows\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <GlobalAnalyzerConfigFiles Include="..\Net10.globalconfig" />
    <Compile Include="**\*.cs" Exclude="obj\**;bin\**" />
    <EmbeddedResource Include="**\*.resx" Exclude="obj\**;bin\**" />
    <PackageReference Include="System.Resources.Extensions" Version="10.0.0" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
