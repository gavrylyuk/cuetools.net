<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <OutputPath>..\bin\$(Configuration)\net10.0-windows\migration-tests\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.5.1" />
    <PackageReference Include="MSTest.TestFramework" Version="4.5.1" />
    <ProjectReference Include="..\CUETools.Processor\CUETools.Processor.csproj" />
    <Compile Include="..\CUETools\SingletonController.Net10.cs" Link="SingletonController.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\bin\$(Configuration)\net10.0\plugins\x64\CUETools.Codecs.TTA.dll" Link="plugins\x64\CUETools.Codecs.TTA.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\bin\$(Configuration)\net10.0\plugins\x64\CUETools.Codecs.TTA.dll')" />
    <None Include="..\bin\$(Configuration)\net10.0\plugins\x64\Ijwhost.dll" Link="plugins\x64\Ijwhost.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\bin\$(Configuration)\net10.0\plugins\x64\Ijwhost.dll')" />
  </ItemGroup>
</Project>

